# =========================================================
# CodeMind AI - Variables de entorno
# Copia este archivo como ".env.local" y completa los valores.
# Las claves NUNCA se envían al navegador: solo el backend las lee.
# =========================================================

# --- Proveedor de IA (compatible con la API de OpenAI) ---
# Base URL del proveedor. Ejemplos:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama local: http://localhost:11434/v1   (API_KEY puede ir vacía)
AI_BASE_URL=https://api.openai.com/v1

# Tu clave de API del proveedor (secreta, solo servidor)
AI_API_KEY=sk-tu-clave-aqui

# Modelo por defecto (si el usuario no elige otro en la interfaz)
# Ejemplos: gpt-4o-mini, llama-3.3-70b-versatile, deepseek-chat
AI_MODEL=gpt-4o-mini

# Nombre visible del proveedor (solo se muestra si HIDE_PROVIDER=false)
AI_PROVIDER_NAME=OpenAI

# --- Marca blanca (opcional) ---
# true = el frontend y la API pública NUNCA revelan el proveedor real ni los
# modelos reales: se muestra PROVIDER_BRAND y los modelos se listan como
# "Motor 1..N" con tokens cifrados que solo el servidor puede descifrar.
HIDE_PROVIDER=false
PROVIDER_BRAND=CodeMind Core

# --- Seguridad ---
# Solicitudes máximas por minuto por IP (las demás reciben error 429)
RATE_LIMIT_PER_MINUTE=20
